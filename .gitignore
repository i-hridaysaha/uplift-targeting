# Data and model artifacts (large / derived / regenerated by the pipeline)
# Root-anchored so the src/uplift/data and src/uplift/models packages are kept.
/data/

# models/ stays gitignored EXCEPT the small demo artifacts the hosted Streamlit
# demo loads: Criteo cannot be rebuilt in the cloud (its source download is dead),
# so the persisted bundles + slim hold-out references (~6 MB, public data only)
# ride into the repo. Everything else under models/ is still ignored.
/models/*
!/models/hillstrom_policy.pkl
!/models/criteo_policy.pkl
!/models/hillstrom_holdout_reference.parquet
!/models/criteo_holdout_reference.parquet

